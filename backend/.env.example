# Copy to backend/.env for local development. On Render, set these in the Environment tab.
GROQ_API_KEY=your_groq_api_key_here

# Optional: override the model (default: llama-3.3-70b-versatile)
GROQ_MODEL=openai/gpt-oss-120b

# Optional: deployed frontend URL(s) allowed to call the API, comma-separated, no trailing slash.
# Localhost on any port is always allowed.
# ALLOWED_ORIGINS=https://ai-interview-coach.vercel.app
